# Google Gemini (required for Content Generator + Engagement Assistant)
# Create a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Web server
PORT=5000

# Timezone for scheduler (always work in UTC for Binance Square)
TIMEZONE=UTC

# --- Binance Square OpenAPI (auto-publisher) ---
# Get a key from Binance Square -> Settings -> Developer -> Square OpenAPI.
# Without this key the publisher always runs in dry-run mode.
X_SQUARE_OPENAPI_KEY=

# Optional override (default: official Binance endpoint)
# SQUARE_API_URL=https://www.binance.com/bapi/composite/v1/public/pgc/openApi/content/add

# Auto-publisher safety knobs
PUBLISH_DRY_RUN=1            # 1 = dry-run, 0 = real posts
PUBLISH_MIN_DELAY_MIN=5      # min minutes to wait between posts
PUBLISH_MAX_DELAY_MIN=30     # max minutes to wait between posts
PUBLISH_DAILY_CAP=12         # stop after N successful posts in a UTC day
